    "webpack-dev-server": "^4.9.3"
  },
  "pnpm": {
    "overrides": {
      "glob-parent": "^6.0.0",
      "express": "4.22.1",
      "hosted-git-info": "^3.0.8",
      "lodash-es": "^4.18.1",
      "lodash": "^4.18.1",
      "minimist": "1.2.8",
      "postcss": "^8.2.13"
    }
  },
  "consolePlugin": {
    "name": "gitops-plugin",
    "version": "0.0.17",
    "displayName": "GitOps Plugin",
    "description": "OpenShift Console plugin for GitOps.",
    "dependencies": {
      "@console/pluginAPI": "~4.18.0"
    }
  },
  "dependencies": {
    "classnames": "^2.3.2",
    "git-url-parse": "^13.1.0",
    "lodash": "^4.18.1",
    "moment": "^2.29.4",
